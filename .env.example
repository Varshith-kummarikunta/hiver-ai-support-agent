# LLM Provider Configuration
# Supported providers: gemini, openai, mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: OPENAI_API_KEY=your_openai_api_key_here

# Model Names
AGENT_MODEL=gemini-2.0-flash
JUDGE_MODEL=gemini-2.0-flash

# Agent Guardrail Thresholds & Constraints (Configurable)
AGENT_MIN_CONFIDENCE=0.40
AGENT_MIN_BM25_SCORE=5.0
AGENT_TOP_K=5
AGENT_MAX_REPLY_CHARS=280 # Maximum character length for public customer reply (concise engineering constraint)

# Paths
RAW_DATA_PATH=./data/raw/twcs.csv
PROCESSED_DATA_DIR=./data/processed
GOLDEN_SET_PATH=./data/golden/golden-set.jsonl
