# Dependencies
node_modules/

# Environment and Secrets
.env
.env.local
.env.*.local

# Raw large datasets (do not commit ~700MB Kaggle CSV to Git)
data/raw/*
!data/raw/.gitkeep

# Large processed dumps and index files (>100MB exceeds GitHub hard push limits)
data/processed/*.jsonl
data/models/applesupport-retrieval-index.json

# Logs
logs/
*.log
npm-debug.log*

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
